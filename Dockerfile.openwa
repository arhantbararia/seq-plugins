# ═══════════════════════════════════════════════════════════════════════════════
# Dockerfile.openwa — OpenWA NestJS + Chromium
# Wrapper around the upstream OpenWA Dockerfile with memory-constrained builds.
# Designed to build on a 1GB RAM VM with 8GB swap.
# ═══════════════════════════════════════════════════════════════════════════════

# ===== Stage 1: Builder =====
FROM docker.io/node:22-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy package files
COPY internal/OpenWA/package*.json ./

# Install all dependencies (devDependencies needed for nest build + vite build)
RUN npm ci --include=dev

# Copy source code
COPY internal/OpenWA/ .

# Build NestJS API + Dashboard SPA with memory-constrained Node.js heap.
# On a 1GB VM with swap, Node will spill into swap — slower but works.
ENV NODE_OPTIONS="--max-old-space-size=768"
RUN npm run build && \
    cd dashboard && npm ci --include=dev && npm run build

# ===== Stage 2: Production =====
FROM docker.io/node:22-slim AS production

# Install Chromium and required dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libappindicator3-1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    xdg-utils \
    dumb-init \
    gosu \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Chromium/Puppeteer configuration
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Create app user
RUN groupadd -r openwa && useradd -r -g openwa openwa

WORKDIR /app

# Copy package files and install production deps only
COPY internal/OpenWA/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy built application from builder stage
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dashboard/dist ./dashboard/dist

# Create data directories
RUN mkdir -p ./data/sessions ./data/media && \
    chown -R openwa:openwa /app

ENV HOME=/app/data
ENV XDG_CONFIG_HOME=/tmp/.config
ENV XDG_CACHE_HOME=/tmp/.cache

# Copy entrypoint from source
COPY internal/OpenWA/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 2785

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:2785/api/health/ready || exit 1

ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "dist/main"]
